---
import Layout from '../../layouts/Layout.astro';
import Tile from '../../components/ornaments/Tile.astro';

const variants = [
  {
    href: '/variants/bayoz',
    label: 'A · Bayoz',
    sub: "qo'lyozma",
    desc: "Cream paper, sepia ink, manuscript page borders. Cormorant Garamond. Pomegranate + gold accents on warm paper.",
    bg: '#f3e7cf',
    ink: '#3a2817',
    accent: '#9c2b2b',
  },
  {
    href: '/variants/koshin',
    label: 'B · Koshin',
    sub: 'Buxoro',
    desc: 'Deep teal + saffron + cream. Bold geometric Bukhara koshin patterns. Editorial grid, Playfair Display.',
    bg: '#f4ead4',
    ink: '#0e3f44',
    accent: '#d68b1f',
  },
  {
    href: '/variants/miniatyura',
    label: 'C · Miniatyura',
    sub: 'zamonaviy',
    desc: 'Warm cream, dusty rose, deep ink, copper hairlines. Asymmetric editorial. DM Serif Display + Cormorant.',
    bg: '#f6efe2',
    ink: '#1a1410',
    accent: '#b35642',
  },
];
---
<Layout title="Muqimiy — Vizual variantlar">
  <main class="wrap">
    <header>
      <div class="kicker">Variants · 3 yo'nalish</div>
      <h1 class="title font-disp">Bosh sahifa <em>variantlari</em>.</h1>
      <p class="lede">
        Har biri butun saytning vizual tilini belgilaydi. Birini tanlasak — boshqa sahifalarni shu uslubda davom ettiramiz.
      </p>
    </header>

    <div class="grid">
      {variants.map((v) => (
        <a href={v.href} class="card" style={`background:${v.bg};color:${v.ink}`}>
          <div class="card-head">
            <Tile size={36} color={v.accent} />
            <span style={`color:${v.accent}`}>{v.label}</span>
          </div>
          <h2 class="card-t font-disp">
            <em style={`color:${v.accent}`}>{v.sub}</em>
          </h2>
          <p class="card-d">{v.desc}</p>
          <span class="card-cta" style={`color:${v.accent}`}>Ko'rish →</span>
        </a>
      ))}
    </div>

    <p class="back"><a href="/">← Asosiy saytga qaytish</a></p>
  </main>
</Layout>

<style>
  .wrap {
    max-width: 1280px;
    margin: 0 auto;
    padding: 80px 60px;
  }
  header { max-width: 820px; margin-bottom: 60px; }
  .kicker {
    font-size: 11px;
    letter-spacing: 0.32em;
    color: var(--saffron-deep);
    text-transform: uppercase;
    font-weight: 700;
    margin-bottom: 16px;
  }
  .title {
    font-size: 88px;
    line-height: 1;
    margin: 0 0 24px;
    color: var(--text);
    font-weight: 900;
    letter-spacing: -0.02em;
  }
  .title em {
    font-style: italic;
    font-weight: 400;
    color: var(--pomegranate);
  }
  .lede {
    font-size: 18px;
    line-height: 1.7;
    color: var(--muted);
    margin: 0;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }
  .card {
    padding: 40px 32px;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    gap: 16px;
    min-height: 360px;
    transition: transform 0.2s;
    border: 1px solid var(--border);
  }
  .card:hover { transform: translateY(-4px); }
  .card-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 11px;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    font-weight: 700;
  }
  .card-t {
    font-size: 48px;
    line-height: 1;
    margin: 0;
    font-weight: 700;
  }
  .card-t em { font-style: italic; font-weight: 400; }
  .card-d {
    font-size: 14px;
    line-height: 1.6;
    margin: 0;
    opacity: 0.78;
  }
  .card-cta {
    margin-top: auto;
    font-size: 12px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    font-weight: 700;
  }
  .back {
    margin-top: 60px;
    font-size: 13px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    font-weight: 700;
  }
  .back a {
    color: var(--text);
    text-decoration: none;
    border-bottom: 1px solid var(--text);
    padding-bottom: 2px;
  }
  @media (max-width: 900px) {
    .wrap { padding: 56px 24px; }
    .title { font-size: 56px; }
    .grid { grid-template-columns: 1fr; }
  }
</style>
