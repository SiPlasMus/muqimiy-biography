---
import PageShell from '../components/PageShell.astro';
import SectionTag from '../components/SectionTag.astro';
import H2 from '../components/H2.astro';

const sources = [
  { t: 'tafakkur.net', url: 'https://tafakkur.net/muhammad-aminxoja-muqimiy.haqida', k: 'Tarjimai hol', d: "Muhammad Aminxo'ja Muqimiy hayoti va ijodi haqida batafsil maqola." },
  { t: 'n.ziyouz.com — Tanlangan asarlar (1953)', url: 'https://n.ziyouz.com/books/uzbek_mumtoz_adabiyoti/Muqimiy.%20Tanlangan%20asarlar%20(1953).pdf', k: 'Devon · PDF', d: "Muqimiyning tanlangan asarlari to'plami. 1953 yilgi nashr." },
  { t: 'arboblar.uz', url: 'https://arboblar.uz/uz/people/mukimi', k: 'Biografiya', d: "Shoir hayoti, ijodi va merosiga oid umumiy ma'lumot." },
  { t: 'uz.wikipedia.org', url: 'https://uz.wikipedia.org/wiki/Muqimiy', k: 'Ensiklopediya', d: "Vikipediya — to'liq tarjimai hol va asarlar ro'yxati." },
  { t: 'researchgate.net', url: 'https://www.researchgate.net/publication/377815609_MUQIMIY_HAYOTI_VA_IJODI', k: 'Tadqiqot', d: 'Muqimiy hayoti va ijodi bo\'yicha ilmiy maqola.' },
  { t: 'cyberleninka.ru — Sayohatnoma tahlili', url: 'https://cyberleninka.ru/article/n/muqimiyning-sayohatnoma-sida-davr-muhit-voqelik-tasviri', k: 'Tadqiqot', d: "“Sayohatnoma”da davr, muhit va voqelik tasviri haqida ilmiy maqola." },
  { t: 'Lirik asarlarining matniy-qiyosiy tahlili', url: 'https://goldenscripts.navoiy-uni.uz/index.php/goldenscripts/article/download/2/2', k: 'Dissertatsiya · PDF', d: 'Muqimiyning lirik asarlari matniy-qiyosiy tahlili bo\'yicha tadqiqot.' },
  { t: "Sputnik O'zbekiston — biografiya", url: 'https://oz.sputniknews.uz/20231025/muqimiy-biografiya-40336201.html', k: 'Maqola', d: "Sputnik O'zbekiston'dagi tarjimai hol maqolasi." },
];

const books = [
  { t: 'Devoni Muqimiy', y: '1907', d: 'Vafotidan keyin chop etilgan birinchi devon.' },
  { t: 'Muqimiy maa hajviyot', y: '1910', d: "Hajviy she'rlarining alohida nashri." },
  { t: 'Muqimiy bayozi', y: '1930-yillar', d: "G'afur G'ulom tomonidan tuzilgan to'plam." },
  { t: 'Muqimiy ijodiy merosi (2 jild)', y: '1960', d: "G'.Karimov tuzgan ikki jildlik akademik nashr." },
];

// Simulated AI assistant — no model is connected. Each question has a
// pre-written answer; the client script "streams" it to mimic a real chatbot.
const aiQA = [
  {
    q: "Muqimiy qachon va qayerda tug'ilgan?",
    a: "Muhammad Aminxo'ja Muqimiy 1850-yilda Qo'qon shahrining Bekvachcha mahallasida tug'ilgan. Otasi Mirzaxo'ja, onasi Oyshabibi esa og'zaki ijodni yaxshi bilgan iqtidorli ayol bo'lib, o'g'lini Navoiy, Hofiz va Jomiy ijodi bilan tanishtirgan.",
  },
  {
    q: "Muqimiyning eng mashhur asarlari qaysilar?",
    a: "Muqimiy lirik shoir bo'lish bilan birga o'tkir hajviy asarlari bilan ham nom qozongan. Eng taniqlilari — “Tanobchilar”, “Veksel”, “Moskovchi boy ta'rifida” va “Sayohatnoma”. “Ko'zlaring” hamda “Yakka bu Farg'onada” kabi g'azallari xalq qo'shig'iga aylangan.",
  },
  {
    q: "“Sayohatnoma” nima haqida yozilgan?",
    a: "“Sayohatnoma” — Muqimiyning Farg'ona vodiysi bo'ylab qilgan safarlari taassurotlari asosida yaratilgan turkum she'rlar. Unda davr muhiti va qishloqlarning ijtimoiy-geografik holati aks etgan: Vodil go'zal tabiati bilan, Chimyon esa zindoni bilan tasvirlanadi.",
  },
  {
    q: "Muqimiy qayerda tahsil olgan?",
    a: "Muqimiy avval Qo'qonda Mulla Abduxalil maktabida, so'ng “Hokim oyim” madrasasida o'qigan. 1872–1873-yillarda Buxorodagi “Mehtar anbar” madrasasida tahsilni davom ettirib, 1876-yilda Qo'qonga qaytib kelgan.",
  },
];
const aiDemoData = JSON.stringify(aiQA).replace(/</g, '\\u003c');
---
<PageShell title="Muqimiy — Manbalar" current="manbalar">
  <section class="header">
    <div>
      <SectionTag>V — Manbalar</SectionTag>
      <H2 size={88} data-anim="hero-h1">
        O'qish<br />
        <span class="italic-accent" data-anim="drift">uchun.</span>
      </H2>
    </div>
    <div class="intro">
      <p>
        Muqimiy hayoti va ijodini chuqurroq o'rganmoqchi bo'lganlar uchun veb-manbalar,
        ilmiy tadqiqotlar va bosma nashrlar.
      </p>
    </div>
  </section>

  <section class="sources-wrap">
    <div class="sub-label">Veb-manbalar va tadqiqotlar</div>
    <div class="sources-grid">
      {sources.map((s, i) => (
        <a
          href={s.url}
          target="_blank"
          rel="noopener"
          class="source"
          data-reveal
          data-reveal-delay={i * 50}
        >
          <div class="source-head">
            <h3 class="source-t font-disp">{s.t}</h3>
            <svg width="20" height="20" viewBox="0 0 16 16" fill="none" stroke="var(--saffron-deep)" stroke-width="1.5">
              <path d="M3 13L13 3M13 3H6M13 3V10" stroke-linecap="round" />
            </svg>
          </div>
          <div class="source-k">{s.k}</div>
          <p class="source-d">{s.d}</p>
        </a>
      ))}
    </div>
  </section>

  <section class="books">
    <div class="books-label">Bosma nashrlar</div>
    <h2 class="books-h2 font-disp">
      Asosiy <span class="italic-light">kitoblar.</span>
    </h2>
    <div class="books-grid">
      {books.map((b, i) => (
        <div class="book" data-reveal data-reveal-delay={i * 80}>
          <div class="book-y font-disp">{b.y}</div>
          <h3 class="book-t font-disp">{b.t}</h3>
          <p class="book-d">{b.d}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="ai-demo">
    <div class="ai-demo-head">
      <div>
        <div class="ai-demo-label">Sun'iy intellekt — namuna</div>
        <h2 class="ai-demo-h2 font-disp">
          Muqimiy haqida <span class="ai-demo-ital">so'rang.</span>
        </h2>
      </div>
      <p class="ai-demo-intro">
        Quyida sun'iy intellekt yordamchisi kelajakda qanday ishlashi mumkinligi
        ko'rsatilgan. Savollardan birini bosing — yordamchi javob beradi.
      </p>
    </div>

    <div class="ai-window" data-reveal>
      <div class="ai-bar">
        <span class="ai-bar-dot"></span>
        <span class="ai-bar-dot"></span>
        <span class="ai-bar-dot"></span>
        <span class="ai-bar-title">Muqimiy AI · namoyish</span>
      </div>
      <div class="ai-thread" id="ai-thread">
        <div class="ai-msg ai-msg-bot">
          <span class="ai-avatar" aria-hidden="true">
            <svg viewBox="0 0 80 80" fill="currentColor">
              <polygon points="40,4 50,30 76,40 50,50 40,76 30,50 4,40 30,30" />
            </svg>
          </span>
          <div class="ai-bubble">
            Assalomu alaykum! Men Muqimiy hayoti va ijodi bo'yicha
            yordamchiman. Pastdagi savollardan birini tanlang.
          </div>
        </div>
      </div>
      <div class="ai-suggest-wrap" id="ai-suggest-wrap">
        <div class="ai-suggest-label">Namunaviy savollar</div>
        <div class="ai-suggest" id="ai-suggest">
          {aiQA.map((item, i) => (
            <button type="button" class="ai-chip" data-i={i}>
              <span class="ai-chip-q">{item.q}</span>
              <span class="ai-chip-ar" aria-hidden="true">↗</span>
            </button>
          ))}
        </div>
      </div>
    </div>
  </section>

  <script id="ai-demo-data" type="application/json" is:inline set:html={aiDemoData}></script>
</PageShell>

<style>
  .italic-accent { font-style: italic; font-weight: 400; color: var(--pomegranate); }
  .italic-light { font-style: italic; font-weight: 400; color: var(--saffron); }

  .header {
    padding: 90px 80px 50px;
    background: var(--bg);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
  }
  .intro {
    font-size: 17px;
    line-height: 1.8;
    color: var(--muted);
    align-self: end;
  }
  .intro p { margin: 0; }

  .sources-wrap {
    padding: 20px 80px 30px;
    background: var(--bg);
  }
  .sub-label {
    font-size: 11px;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--saffron-deep);
    font-weight: 700;
    margin-bottom: 20px;
  }
  .sources-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
  }
  .source {
    background: var(--card-bg);
    border: 1px solid var(--border);
    padding: 24px 28px;
    display: block;
    text-decoration: none;
    color: var(--text);
    transition: border-color 0.2s, transform 0.3s cubic-bezier(0.2, 0.7, 0.2, 1),
                box-shadow 0.3s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .source:hover {
    border-color: var(--saffron);
    transform: translateY(-3px);
    box-shadow: 0 14px 32px -18px rgba(10, 32, 36, 0.22);
  }
  .source :global(svg) {
    transition: transform 0.3s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .source:hover :global(svg) {
    transform: translate(4px, -4px);
  }
  .source-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 10px;
    gap: 16px;
  }
  .source-t {
    font-size: 24px;
    margin: 0;
    font-weight: 700;
    color: var(--teal);
    line-height: 1.2;
  }
  .source-k {
    font-size: 10px;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--saffron-deep);
    font-weight: 700;
    margin-bottom: 10px;
  }
  .source-d {
    margin: 0;
    font-size: 14px;
    line-height: 1.6;
    color: var(--muted);
  }

  .books {
    padding: 60px 80px;
    background: var(--teal-deep);
    color: var(--cream);
  }
  .books-label {
    font-size: 11px;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--saffron);
    font-weight: 700;
    margin-bottom: 20px;
  }
  .books-h2 {
    font-size: 56px;
    margin: 0 0 40px;
    font-weight: 900;
    line-height: 1;
  }
  .books-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }
  .book {
    border-top: 2px solid var(--saffron);
    padding-top: 20px;
  }
  .book-y {
    font-size: 32px;
    font-weight: 700;
    color: var(--saffron);
    margin-bottom: 6px;
  }
  .book-t {
    font-size: 22px;
    margin: 0 0 10px;
    font-weight: 700;
  }
  .book-d {
    margin: 0;
    font-size: 14px;
    line-height: 1.65;
    color: rgba(244, 234, 212, 0.7);
  }

  @media (max-width: 1000px) {
    .header, .sources-wrap, .books { padding-left: 24px; padding-right: 24px; }
    .header { grid-template-columns: 1fr; gap: 32px; padding-top: 56px; padding-bottom: 32px; }
    .sources-grid { grid-template-columns: 1fr; }
    .books-grid { grid-template-columns: repeat(2, 1fr); }
    .books-h2 { font-size: 36px; }
  }
</style>

<style is:global>
  /* ── AI demo — selectors prefixed .ai- so the global block stays inert
        elsewhere. Chat bubbles are built client-side, so component-scoped
        styles can't reach them; these rules cover the injected DOM. ────── */
  .ai-demo {
    padding: 70px 80px 90px;
    background: var(--bg);
  }
  .ai-demo-head {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: end;
    margin-bottom: 36px;
  }
  .ai-demo-label {
    font-size: 11px;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--saffron-deep);
    font-weight: 700;
    margin-bottom: 16px;
  }
  .ai-demo-h2 {
    font-size: 52px;
    margin: 0;
    font-weight: 900;
    line-height: 1;
    color: var(--teal);
    letter-spacing: -0.02em;
  }
  .ai-demo-ital {
    font-style: italic;
    font-weight: 400;
    color: var(--pomegranate);
  }
  .ai-demo-intro {
    margin: 0;
    font-size: 16px;
    line-height: 1.8;
    color: var(--muted);
  }

  .ai-window {
    border: 1px solid var(--border);
    background: var(--card-bg);
    max-width: 780px;
  }
  .ai-bar {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 14px 20px;
    border-bottom: 1px solid var(--border);
    background: var(--cream-soft);
  }
  .ai-bar-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--border);
  }
  .ai-bar-dot:nth-child(1) { background: var(--pomegranate); }
  .ai-bar-dot:nth-child(2) { background: var(--saffron); }
  .ai-bar-dot:nth-child(3) { background: var(--teal-mid); }
  .ai-bar-title {
    margin-left: 10px;
    font-size: 11px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--muted);
  }

  .ai-thread {
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    max-height: 400px;
    overflow-y: auto;
  }
  .ai-msg {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    animation: ai-pop 0.3s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }
  @keyframes ai-pop {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: none; }
  }
  .ai-msg-user { flex-direction: row-reverse; }
  .ai-avatar {
    flex-shrink: 0;
    width: 34px;
    height: 34px;
    display: grid;
    place-items: center;
    background: var(--teal);
    color: var(--saffron);
  }
  .ai-avatar svg {
    width: 20px;
    height: 20px;
    display: block;
  }
  .ai-bubble {
    font-size: 15px;
    line-height: 1.7;
    padding: 13px 18px;
    max-width: 80%;
    border: 1px solid var(--border);
  }
  .ai-msg-bot .ai-bubble {
    background: var(--cream-soft);
    color: var(--text);
  }
  .ai-msg-user .ai-bubble {
    background: var(--teal);
    color: var(--cream);
    border-color: var(--teal);
  }
  .ai-bubble-end {
    font-style: italic;
    color: var(--muted);
  }

  /* Typing indicator */
  .ai-typing {
    display: flex;
    gap: 5px;
    align-items: center;
    padding: 17px 18px;
  }
  .ai-typing span {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--saffron-deep);
    animation: ai-bounce 1s infinite ease-in-out;
  }
  .ai-typing span:nth-child(2) { animation-delay: 0.16s; }
  .ai-typing span:nth-child(3) { animation-delay: 0.32s; }
  @keyframes ai-bounce {
    0%, 80%, 100% { transform: translateY(0); opacity: 0.4; }
    40% { transform: translateY(-5px); opacity: 1; }
  }
  /* Blinking caret while an answer streams in */
  .ai-bubble.ai-stream::after {
    content: '';
    display: inline-block;
    width: 2px;
    height: 1em;
    margin-left: 2px;
    vertical-align: -2px;
    background: var(--saffron-deep);
    animation: ai-blink 0.8s steps(1) infinite;
  }
  @keyframes ai-blink {
    50% { opacity: 0; }
  }

  /* Suggestions */
  .ai-suggest-wrap {
    border-top: 1px solid var(--border);
    padding: 20px 24px;
  }
  .ai-suggest-label {
    font-size: 10px;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--muted);
    font-weight: 700;
    margin-bottom: 14px;
  }
  .ai-suggest {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .ai-chip {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: transparent;
    border: 1.5px solid var(--border);
    color: var(--text);
    padding: 11px 16px;
    font-size: 14px;
    font-family: inherit;
    line-height: 1.4;
    cursor: pointer;
    text-align: left;
    transition: border-color 0.18s, background-color 0.18s, transform 0.18s;
  }
  .ai-chip:hover {
    border-color: var(--saffron);
    background: var(--cream-soft);
    transform: translateY(-2px);
  }
  .ai-chip-ar {
    color: var(--saffron-deep);
    font-weight: 700;
    flex-shrink: 0;
  }

  @media (max-width: 1000px) {
    .ai-demo { padding: 56px 24px 72px; }
    .ai-demo-head { grid-template-columns: 1fr; gap: 24px; }
    .ai-demo-h2 { font-size: 36px; }
    .ai-bubble { max-width: 88%; }
  }
</style>

<script>
  function initAiDemo() {
    const thread = document.getElementById('ai-thread');
    const suggest = document.getElementById('ai-suggest');
    const suggestWrap = document.getElementById('ai-suggest-wrap');
    if (!thread || !suggest || !suggestWrap) return;

    // initAiDemo can fire twice for one page (direct call + astro:page-load).
    // Bind only once per fresh #ai-thread.
    if (thread.dataset.aiBound === '1') return;
    thread.dataset.aiBound = '1';

    let QA = [];
    const dataEl = document.getElementById('ai-demo-data');
    if (dataEl && dataEl.textContent) {
      try { QA = JSON.parse(dataEl.textContent); } catch (err) { QA = []; }
    }

    // Single source of truth for the avatar mark — clone it from the
    // server-rendered intro message.
    const seedAvatar = thread.querySelector('.ai-avatar');
    const STAR = seedAvatar ? seedAvatar.innerHTML : '';
    const reduceMotion =
      window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    let busy = false;

    function scrollDown() {
      thread.scrollTop = thread.scrollHeight;
    }

    function addUser(text) {
      const el = document.createElement('div');
      el.className = 'ai-msg ai-msg-user';
      const bubble = document.createElement('div');
      bubble.className = 'ai-bubble';
      bubble.textContent = text;
      el.appendChild(bubble);
      thread.appendChild(el);
      scrollDown();
    }

    function addBot(typing) {
      const el = document.createElement('div');
      el.className = 'ai-msg ai-msg-bot';
      const avatar = document.createElement('span');
      avatar.className = 'ai-avatar';
      avatar.setAttribute('aria-hidden', 'true');
      avatar.innerHTML = STAR;
      const bubble = document.createElement('div');
      bubble.className = 'ai-bubble';
      if (typing) {
        bubble.className += ' ai-typing';
        bubble.innerHTML = '<span></span><span></span><span></span>';
      }
      el.appendChild(avatar);
      el.appendChild(bubble);
      thread.appendChild(el);
      scrollDown();
      return bubble;
    }

    // Reveal the answer word by word so it reads like a live model reply.
    function streamAnswer(bubble, text, done) {
      bubble.className = 'ai-bubble';
      if (reduceMotion) {
        bubble.textContent = text;
        scrollDown();
        done();
        return;
      }
      bubble.classList.add('ai-stream');
      bubble.textContent = '';
      const words = text.split(' ');
      let i = 0;
      (function step() {
        if (i >= words.length) {
          bubble.classList.remove('ai-stream');
          done();
          return;
        }
        bubble.textContent += (i ? ' ' : '') + words[i];
        i += 1;
        scrollDown();
        setTimeout(step, 40);
      })();
    }

    function answer(i) {
      const qa = QA[i];
      if (!qa) return;
      busy = true;
      addUser(qa.q);
      const typingBubble = addBot(true);
      setTimeout(function () {
        streamAnswer(typingBubble, qa.a, function () {
          busy = false;
          // No questions left — close the demo with a wrap-up note.
          if (!suggest.querySelector('.ai-chip')) {
            suggestWrap.style.display = 'none';
            const closing = addBot(false);
            closing.classList.add('ai-bubble-end');
            closing.textContent =
              'Barcha namunaviy savollarga javob berildi. Haqiqiy yordamchi ' +
              'istalgan savolingizga shu tarzda javob bera olardi.';
          }
        });
      }, 720);
    }

    suggest.addEventListener('click', function (e) {
      const chip = e.target.closest('.ai-chip');
      if (!chip || !suggest.contains(chip) || busy) return;
      const i = Number(chip.dataset.i);
      chip.remove();
      answer(i);
    });
  }

  initAiDemo();
  document.addEventListener('astro:page-load', initAiDemo);
</script>
