---
import PageShell from '../components/PageShell.astro';
import SectionTag from '../components/SectionTag.astro';
import H2 from '../components/H2.astro';
import Medallion from '../components/ornaments/Medallion.astro';
import Lightbox from '../components/Lightbox.astro';
import muqimiyImg from '../assets/muqimiy_flat.jpg';

const items = [
  { t: 'Muqimiy portreti', k: 'Tasvir', note: "Shoirning an'anaviy chizgilangan portreti — sallasi, oq soqoli bilan." },
  { t: "Qo'qon shahri", k: 'XIX asr', note: "Muqimiy tug'ilib o'sgan Bekvachcha mahallasi joylashgan shahar." },
  { t: 'Mohlaroyim madrasasi', k: 'Madrasa', note: "Nodira tomonidan qurdirilgan, Muqimiy ta'lim olgan madrasa." },
  { t: 'Buxoro madrasasi', k: 'Madrasa', note: '1875–76 yillarda Muqimiy o\'qigan Buxoro madrasalaridan.' },
  { t: 'Hazrat hujrasi', k: 'Yashash joyi', note: "Otasi vafotidan keyin Muqimiy ko'chgan kichik hujra." },
  { t: 'Devoni Muqimiy 1907', k: 'Kitob', note: 'Vafotidan keyin chop etilgan birinchi devon.' },
  { t: 'Muqimiy qo\'lyozmasi', k: 'Qo\'lyozma', note: 'Bayozlarda saqlangan she\'rlardan namuna.' },
  { t: 'Muqimiy uy-muzeyi', k: 'Muzey', note: "Qo'qonda tashkil etilgan uy-muzey." },
];

const tilePattern = `url("data:image/svg+xml;utf8,${encodeURIComponent(
  `<svg xmlns='http://www.w3.org/2000/svg' width='60' height='60' viewBox='0 0 60 60' fill='none' stroke='%23f4ead4' stroke-width='1'><polygon points='30,3 38,22 57,30 38,38 30,57 22,38 3,30 22,22'/></svg>`,
)}")`;

const tileBgs = ['var(--teal)', 'var(--saffron)', 'var(--teal-mid)'];
---
<PageShell title="Muqimiy — Galereya" current="galereya">
  <section class="header">
    <div>
      <SectionTag>IV — Galereya</SectionTag>
      <H2 size={88} data-anim="hero-h1">
        Shoirning<br />
        <span class="italic-accent" data-anim="drift">dunyosi.</span>
      </H2>
    </div>
    <div class="intro">
      <p>
        Muqimiy hayoti va ijodi bilan bog'liq joylar, qo'lyozmalar va kitoblar. Rasm joylari joylashtirilgan
        — keyinroq haqiqiy materiallar bilan to'ldiramiz.
      </p>
    </div>
  </section>

  <section class="grid-wrap">
    <div class="grid">
      {items.map((it, i) => (
        <figure
          class="card"
          data-reveal
          data-reveal-delay={i * 50}
          data-lightbox
          data-title={it.t}
          data-kind={it.k}
          data-note={it.note}
          tabindex="0"
          role="button"
          aria-label={`${it.t} — kattalashtirish`}
        >
          <div class="thumb" style={`background:${tileBgs[i % 3]}`}>
            <div class="pattern" style={`background-image:${tilePattern};background-size:60px 60px`}></div>
            {i === 0 ? (
              <svg class="thumb-img" viewBox="0 0 1920 1920" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg">
                <image href={muqimiyImg.src} width="1920" height="1920" />
              </svg>
            ) : (
              <div class="placeholder">
                <Medallion size={120} color="var(--cream)" stroke={1} />
                <div class="placeholder-l">Rasm joyi</div>
              </div>
            )}
          </div>
          <figcaption>
            <div class="kind">{it.k}</div>
            <h3 class="title font-disp">{it.t}</h3>
            <p class="note">{it.note}</p>
          </figcaption>
        </figure>
      ))}
    </div>
  </section>

  <Lightbox />
</PageShell>

<style>
  .italic-accent { font-style: italic; font-weight: 400; color: var(--pomegranate); }

  .header {
    padding: 90px 80px 50px;
    background: var(--bg);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
  }
  .intro {
    font-size: 17px;
    line-height: 1.8;
    color: var(--muted);
    align-self: end;
  }
  .intro p { margin: 0; }

  .grid-wrap {
    padding: 30px 80px 80px;
    background: var(--bg);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }
  .card {
    margin: 0;
    background: var(--card-bg);
    border: 1px solid var(--border);
    transition: transform 0.35s cubic-bezier(0.2, 0.7, 0.2, 1),
                box-shadow 0.35s cubic-bezier(0.2, 0.7, 0.2, 1),
                border-color 0.2s;
    cursor: pointer;
  }
  .card:hover {
    transform: translateY(-4px);
    box-shadow: 0 18px 40px -20px rgba(10, 32, 36, 0.22);
    border-color: var(--saffron);
  }
  .card:focus-visible {
    outline: 2px solid var(--saffron);
    outline-offset: 4px;
  }
  .thumb {
    aspect-ratio: 1 / 1.15;
    position: relative;
    overflow: hidden;
    display: grid;
    place-items: center;
  }
  .thumb > :global(svg) {
    transition: transform 0.5s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .thumb-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }
  .card:hover .thumb > :global(svg) {
    transform: scale(1.06);
  }
  .card:hover .title { color: var(--pomegranate); }
  .title { transition: color 0.2s; }
  .pattern {
    position: absolute;
    inset: 0;
    opacity: 0.15;
  }
  .placeholder {
    position: relative;
    z-index: 2;
    text-align: center;
    color: var(--cream);
    padding: 20px;
  }
  .placeholder-l {
    font-size: 10px;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    margin-top: 12px;
    opacity: 0.85;
  }
  figcaption { padding: 16px 18px 18px; }
  .kind {
    font-size: 10px;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--saffron-deep);
    font-weight: 700;
    margin-bottom: 6px;
  }
  .title {
    font-size: 22px;
    margin: 0 0 8px;
    font-weight: 700;
    color: var(--text);
  }
  .note {
    margin: 0;
    font-size: 13px;
    line-height: 1.6;
    color: var(--muted);
  }

  @media (max-width: 1200px) {
    .grid { grid-template-columns: repeat(3, 1fr); }
  }
  @media (max-width: 900px) {
    .header, .grid-wrap { padding-left: 24px; padding-right: 24px; }
    .header { grid-template-columns: 1fr; gap: 32px; padding-top: 56px; padding-bottom: 32px; }
    .grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 540px) {
    .grid { grid-template-columns: 1fr; }
  }
</style>
