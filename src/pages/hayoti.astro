---
import PageShell from '../components/PageShell.astro';
import SectionTag from '../components/SectionTag.astro';
import H2 from '../components/H2.astro';

const events = [
  { y: '1850', t: "Qo'qonda tug'ilish", d: "Qo'qon shahrining Bekvachcha mahallasida, novvoy Mirzaxo'ja oilasida dunyoga keldi. Oiladagi 5 farzand ichida yolg'iz o'g'il bo'lgan." },
  { y: '1864–1865', t: "Maktab va «Moxlaroyim» madrasasi", d: "Ilk ta'limni mahalla maktabida olgach, Qo'qondagi Nodirabegim bino qildirgan «Moxlar oyim» («Hokim oyim») madrasasida tahsil oldi." },
  { y: '1872–1876', t: "Buxoro — «Mehtar oyim» madrasasi", d: "Buxoroga borib, mashhur «Mehtar oyim» («Muxtor oyim») madrasasida o'qishni davom ettirdi. Bu yerda fors tilini mukammal o'rganib, she'r yozish mahoratini oshirdi." },
  { y: '1876', t: "Qo'qonga qaytish, uylanish, mirzalik", d: "Qo'qonga qaytib uylandi va yer o'lchash (qurilish) mahkamasida mirzalik qila boshladi. Bu ish tufayli qishloqlarni kezib, xalqning og'ir hayotini yaqindan ko'rdi — «Tanobchilar» satirasi shu kuzatuvlardan tug'ildi." },
  { y: '1885', t: "Otasining vafoti, «Hazrat» hujrasi", d: "Otasining vafotidan keyin moddiy ahvoli og'irlashib, Qo'qondagi «Hazrat» madrasasining kichik bir hujrasiga ko'chib o'tdi va umrining oxirigacha shu yerda qashshoqlikda yashadi.", highlight: true },
  { y: '1887–1888', t: 'Toshkent safari', d: "Toshkent shahriga sayohat qildi. Madaniy yangiliklar, rus maorif tizimi bilan tanishdi. Almaiy va Nodim kabi ijodkorlar bilan hamkorlik qildi." },
  { y: '1892', t: 'Ikkinchi Toshkent safari', d: "Toshkent bilan adabiy aloqani davom ettirdi. Bu va keyingi safarlar taassuroti «Sayohatnoma»ga asos bo'ldi." },
  { y: '1903', t: 'Vafoti — 25-may', d: "53 yoshida Qo'qon shahrida vafot etdi. Qo'qonda dafn etildi." },
];
---
<PageShell title="Muqimiy — Hayoti" current="hayoti">
  <section class="header">
    <div>
      <SectionTag>I — Hayoti</SectionTag>
      <H2 size={88} data-anim="hero-h1">
        Bekvachchadan<br />
        <span class="italic-accent" data-anim="drift">Hazratgacha.</span>
      </H2>
    </div>
    <div class="intro"></div>
  </section>

  <section class="timeline">
    <div class="line"></div>
    {events.map((e, i) => (
      <div class="row" data-reveal data-reveal-delay={i * 60}>
        <div class="year font-disp">{e.y}</div>
        <div class="content">
          <div class:list={['marker', { highlight: e.highlight }]}></div>
          <h3 class="event-title font-disp">{e.t}</h3>
          <p class="event-desc">{e.d}</p>
        </div>
      </div>
    ))}
  </section>

  <section class="pull-quote">
    <div class="pq-grid" data-reveal>
      <div>
        <SectionTag>So'zboshi</SectionTag>
        <h3 class="pq-title font-disp">Qashshoqlik, lekin so'zda boylik.</h3>
        <p class="pq-text">
          Otasining vafotidan keyin Hazrat madrasasining kichik hujrasiga ko'chgan Muqimiy
          umrining oxirigacha shu yerda yashadi. Moddiy qiyinchilik, muhtojlik, ruhiy azoblar
          sog'lig'iga salbiy ta'sir qildi. Ammo aynan shu davrda yaratilgan asarlari adabiyotning oltin merosiga aylandi.
        </p>
      </div>
      <blockquote class="pq-quote font-disp">
        “Kun sovuq, qora chiroq,<br />go'rdek uyu, o'tin kam.<br />Chiqsam eshikka qilur<br />to'rg'ayi chuldir-chuldir.”
        <div class="pq-attr">— Sayohatnoma'dan</div>
      </blockquote>
    </div>
  </section>
</PageShell>

<style>
  .italic-accent {
    font-style: italic;
    font-weight: 400;
    color: var(--pomegranate);
  }
  .header {
    padding: 90px 80px 70px;
    background: var(--bg);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
  }
  .intro {
    font-size: 17px;
    line-height: 1.8;
    color: var(--muted);
    align-self: end;
  }
  .timeline {
    padding: 40px 80px 80px;
    background: var(--bg);
    position: relative;
  }
  .line {
    position: absolute;
    left: 180px;
    top: 40px;
    bottom: 80px;
    width: 2px;
    background: var(--rule);
  }
  .row {
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: 60px;
    padding-bottom: 50px;
    position: relative;
  }
  .year {
    text-align: right;
    font-size: 26px;
    font-weight: 700;
    color: var(--saffron);
    line-height: 1;
    white-space: nowrap;
  }
  .content {
    position: relative;
  }
  .marker {
    position: absolute;
    left: -38px;
    top: 14px;
    width: 18px;
    height: 18px;
    background: var(--saffron);
    transform: rotate(45deg);
    border: 3px solid var(--bg);
  }
  .marker.highlight { background: var(--pomegranate); }
  .event-title {
    font-size: 32px;
    margin: 0 0 10px;
    font-weight: 700;
    color: var(--text);
  }
  .event-desc {
    margin: 0;
    font-size: 16px;
    line-height: 1.7;
    color: var(--muted);
    max-width: 640px;
  }

  .pull-quote {
    background: var(--teal-deep);
    color: var(--cream);
    padding: 70px 100px;
  }
  .pq-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: center;
  }
  .pq-title {
    font-size: 48px;
    margin: 0 0 18px;
    font-weight: 700;
    color: var(--cream);
    line-height: 1.15;
  }
  .pq-text {
    font-size: 16px;
    line-height: 1.8;
    color: rgba(244, 234, 212, 0.78);
    margin: 0;
  }
  .pq-quote {
    font-style: italic;
    font-size: 28px;
    line-height: 1.5;
    color: var(--saffron);
    margin: 0;
    padding-left: 40px;
    border-left: 3px solid var(--saffron);
  }
  .pq-attr {
    margin-top: 18px;
    font-style: normal;
    font-size: 11px;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: rgba(244, 234, 212, 0.6);
    font-weight: 700;
  }

  @media (max-width: 1000px) {
    .header { grid-template-columns: 1fr; padding: 60px 24px; gap: 32px; }
    .timeline { padding: 20px 24px 40px; }
    .line { left: 100px; }
    .row { grid-template-columns: 80px 1fr; gap: 28px; }
    .year { font-size: 17px; }
    .pull-quote { padding: 48px 24px; }
    .pq-grid { grid-template-columns: 1fr; gap: 32px; }
    .pq-title { font-size: 32px; }
    .pq-quote { font-size: 22px; padding-left: 24px; }
  }
</style>
