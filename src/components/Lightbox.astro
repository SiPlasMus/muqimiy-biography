---
// Image / artifact lightbox for Galereya. Stage is filled via JS on open.
---
<dialog id="lightbox" class="app-dialog lightbox" aria-labelledby="lightbox-title">
  <div class="lightbox-shell">
    <button class="lb-close" type="button" data-close aria-label="Yopish">×</button>
    <div class="lb-stage" data-slot="lightbox-stage"></div>
    <div class="lb-caption">
      <div class="lb-kind" data-slot="lightbox-kind"></div>
      <h2 id="lightbox-title" class="lb-title font-disp" data-slot="lightbox-caption"></h2>
      <p class="lb-note" data-slot="lightbox-note"></p>
    </div>
  </div>
</dialog>

<style>
  .lightbox[open] { display: grid; place-items: center; padding: 32px; }
  .lightbox-shell {
    width: min(1100px, 100%);
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 32px;
    background: var(--bg);
    border: 1px solid var(--border);
    padding: 32px;
    position: relative;
    box-shadow: 0 30px 80px rgba(7, 43, 48, 0.35);
  }
  .lb-close {
    position: absolute;
    top: 8px;
    right: 12px;
    background: transparent;
    border: none;
    font-size: 32px;
    line-height: 1;
    color: var(--text);
    cursor: pointer;
    padding: 4px 12px;
    z-index: 2;
    transition: color 0.2s, transform 0.2s;
  }
  .lb-close:hover { color: var(--pomegranate); transform: rotate(90deg); }
  .lb-stage {
    aspect-ratio: 1 / 1.15;
    background: var(--teal);
    overflow: hidden;
    position: relative;
    display: grid;
    place-items: center;
  }
  .lb-stage :global(.thumb) {
    width: 100%;
    height: 100%;
  }
  .lb-caption {
    align-self: center;
  }
  .lb-kind {
    font-size: 11px;
    letter-spacing: 0.32em;
    color: var(--saffron-deep);
    text-transform: uppercase;
    font-weight: 700;
    margin-bottom: 12px;
  }
  .lb-title {
    font-size: 36px;
    margin: 0 0 16px;
    font-weight: 700;
    color: var(--teal);
    line-height: 1.1;
  }
  .lb-note {
    font-size: 15px;
    line-height: 1.7;
    color: var(--muted);
    margin: 0;
  }
  @media (max-width: 720px) {
    .lightbox-shell {
      grid-template-columns: 1fr;
      padding: 16px;
    }
    .lb-title { font-size: 28px; }
  }
</style>
