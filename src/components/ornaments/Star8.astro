---
interface Props {
  size?: number;
  color?: string;
  stroke?: number;
}
const { size = 40, color = 'currentColor', stroke = 1.2 } = Astro.props;
---
<svg width={size} height={size} viewBox="-50 -50 100 100" fill="none" stroke={color} stroke-width={stroke}>
  <polygon points="0,-44 12,-12 44,0 12,12 0,44 -12,12 -44,0 -12,-12" />
  <polygon points="-31,-31 31,-31 31,31 -31,31" transform="rotate(22.5)" />
</svg>
