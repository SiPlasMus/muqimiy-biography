---
interface Props {
  width?: number;
  color?: string;
}
const { width = 80, color = 'currentColor' } = Astro.props;
---
<svg width={width} height="14" viewBox="0 0 80 14" fill="none" stroke={color} stroke-width="1.2" stroke-linecap="round">
  <path d="M 2 7 Q 14 0, 26 7 T 50 7 T 78 7" />
  <circle cx="40" cy="7" r="1.5" fill={color} />
</svg>
