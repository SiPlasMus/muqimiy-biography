---
interface Props {
  width?: number;
  color?: string;
  stroke?: number;
  height?: number;
}
const { width = 600, color = 'currentColor', stroke = 1, height = 28 } = Astro.props;
const mid = height / 2;
---
<svg width={width} height={height} viewBox={`0 0 ${width} ${height}`} fill="none" stroke={color} stroke-width={stroke}>
  <line x1="0" y1={mid} x2={width / 2 - 20} y2={mid} />
  <line x1={width / 2 + 20} y1={mid} x2={width} y2={mid} />
  <g transform={`translate(${width / 2} ${mid})`}>
    <polygon points="0,-10 3,-3 10,0 3,3 0,10 -3,3 -10,0 -3,-3" fill={color} stroke="none" />
    <circle r="14" />
  </g>
</svg>
