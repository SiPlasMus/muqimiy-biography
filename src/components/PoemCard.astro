---
interface Props {
  n: string;
  title: string;
  kind: string;
  lines: string[];
  note?: string;
  featured?: boolean;
}
const { n, title, kind, lines, note = '', featured = false } = Astro.props;
const linesAttr = lines.join('\n');
---
<article
  class:list={['poem-card', { featured }]}
  data-open="poem-modal"
  data-poem-title={title}
  data-poem-kind={kind}
  data-poem-lines={linesAttr}
  data-poem-note={note}
  tabindex="0"
  role="button"
  aria-label={`${title} — to'liq matnni ochish`}
>
  <div class="head">
    <div class="num font-disp">{n}</div>
    <div class="kind">{kind}</div>
  </div>
  <h3 class="title font-disp">{title}</h3>
  <div class="lines">
    {lines.map((l) => <div class="line">{l}</div>)}
  </div>
  <div class="actions">
    <button class="btn-ghost" type="button" onclick="event.stopPropagation()">PDF</button>
    <button class="btn-primary" type="button">O'zingizni sinab ko'ring →</button>
  </div>
</article>

<style>
  .poem-card {
    background: var(--card-bg);
    color: var(--text);
    padding: 32px 28px 24px;
    border: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    transition: transform 0.35s cubic-bezier(0.2, 0.7, 0.2, 1),
                box-shadow 0.35s cubic-bezier(0.2, 0.7, 0.2, 1),
                border-color 0.2s;
    will-change: transform;
    cursor: pointer;
  }
  .poem-card:focus-visible {
    outline: 2px solid var(--saffron);
    outline-offset: 4px;
  }
  .poem-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 18px 40px -20px rgba(10, 32, 36, 0.22);
    border-color: var(--saffron);
  }
  .poem-card.featured {
    background: var(--teal);
    color: var(--cream);
    border-color: var(--teal);
  }
  .poem-card.featured:hover { border-color: var(--saffron); }
  .head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 22px;
  }
  .num {
    font-size: 32px;
    font-weight: 700;
    color: var(--saffron-deep);
  }
  .featured .num { color: var(--saffron); }
  .kind {
    font-size: 10px;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--muted);
    font-weight: 700;
  }
  .featured .kind { color: rgba(244, 234, 212, 0.7); }
  .title {
    font-size: 36px;
    margin: 0 0 22px;
    font-weight: 700;
    color: var(--teal);
    line-height: 1.05;
  }
  .featured .title { color: var(--cream); }
  .lines {
    border-top: 2px solid var(--rule);
    padding-top: 18px;
    margin-bottom: 26px;
  }
  .featured .lines { border-top-color: var(--saffron); }
  .line {
    font-family: 'Playfair Display', Georgia, serif;
    font-style: italic;
    font-size: 18px;
    line-height: 1.65;
  }
  .actions {
    margin-top: auto;
    display: flex;
    gap: 8px;
  }
  .btn-ghost,
  .btn-primary {
    padding: 11px 12px;
    font-size: 10px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    font-weight: 700;
    cursor: pointer;
    transition: transform 0.18s ease, background-color 0.18s ease, color 0.18s ease;
  }
  .btn-ghost:hover,
  .btn-primary:hover { transform: translateY(-2px); }
  .btn-ghost {
    flex: 1;
    background: transparent;
    color: var(--teal);
    border: 1px solid var(--teal);
  }
  .featured .btn-ghost {
    color: var(--cream);
    border-color: rgba(244, 234, 212, 0.4);
  }
  .btn-primary {
    flex: 2;
    background: var(--teal);
    color: var(--cream);
    border: none;
    letter-spacing: 0.18em;
  }
  .featured .btn-primary {
    background: var(--saffron);
    color: var(--teal-deep);
  }
</style>
