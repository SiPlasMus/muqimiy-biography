---
// One per page — content is populated via data-* attributes when opened.
---
<dialog id="poem-modal" class="app-dialog poem-modal" aria-labelledby="poem-modal-title">
  <div class="modal-shell">
    <button class="modal-close" type="button" data-close aria-label="Yopish">×</button>
    <div class="modal-head">
      <div class="modal-kind" data-slot="kind"></div>
      <h2 id="poem-modal-title" class="modal-title font-disp" data-slot="title"></h2>
    </div>
    <div class="modal-body" data-slot="lines"></div>
    <div class="modal-note" data-slot="note"></div>
    <div class="modal-actions">
      <button class="m-ghost" type="button" data-close>Yopish</button>
      <button class="m-primary" type="button">PDF yuklab olish</button>
    </div>
  </div>
</dialog>

<style is:global>
  dialog.app-dialog {
    border: none;
    background: transparent;
    padding: 0;
    max-width: none;
    max-height: none;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: auto;
  }
  dialog.app-dialog::backdrop {
    background: rgba(7, 43, 48, 0);
    backdrop-filter: blur(0px);
    transition: background-color 0.25s, backdrop-filter 0.25s;
  }
  dialog.app-dialog[open]::backdrop {
    background: rgba(7, 43, 48, 0.55);
    backdrop-filter: blur(10px);
  }
  @keyframes app-dialog-in {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }
  @keyframes app-dialog-out {
    from { opacity: 1; transform: translateY(0); }
    to { opacity: 0; transform: translateY(20px); }
  }
  dialog.app-dialog[open] .modal-shell,
  dialog.app-dialog[open] .lightbox-shell {
    animation: app-dialog-in 0.32s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }
  @media (prefers-reduced-motion: reduce) {
    dialog.app-dialog[open] .modal-shell,
    dialog.app-dialog[open] .lightbox-shell {
      animation: none;
    }
  }
</style>

<style>
  .poem-modal[open] {
    display: grid;
    place-items: center;
    padding: 40px 20px;
  }
  .modal-shell {
    width: min(640px, 100%);
    background: var(--bg);
    color: var(--text);
    border: 1px solid var(--border);
    padding: 48px 44px 36px;
    position: relative;
    box-shadow: 0 30px 80px rgba(7, 43, 48, 0.35);
  }
  .modal-close {
    position: absolute;
    top: 12px;
    right: 16px;
    background: transparent;
    border: none;
    font-size: 32px;
    line-height: 1;
    color: var(--text);
    cursor: pointer;
    padding: 4px 12px;
    transition: color 0.2s, transform 0.2s;
  }
  .modal-close:hover { color: var(--pomegranate); transform: rotate(90deg); }
  .modal-head { margin-bottom: 24px; }
  .modal-kind {
    font-size: 11px;
    letter-spacing: 0.32em;
    color: var(--saffron-deep);
    text-transform: uppercase;
    font-weight: 700;
    margin-bottom: 12px;
  }
  .modal-title {
    font-size: 48px;
    margin: 0;
    font-weight: 700;
    color: var(--teal);
    line-height: 1.05;
  }
  .modal-body {
    border-top: 2px solid var(--saffron);
    padding-top: 24px;
    margin-bottom: 24px;
  }
  .modal-body :global(.modal-line) {
    font-family: 'Playfair Display', Georgia, serif;
    font-style: italic;
    font-size: 22px;
    line-height: 1.7;
    color: var(--text);
  }
  .modal-note {
    font-size: 13px;
    line-height: 1.6;
    color: var(--muted);
    margin-bottom: 32px;
  }
  .modal-actions {
    display: flex;
    gap: 10px;
  }
  .m-ghost,
  .m-primary {
    padding: 12px 18px;
    font-size: 11px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    font-weight: 700;
    cursor: pointer;
    font-family: inherit;
    transition: transform 0.2s, background-color 0.2s;
  }
  .m-ghost { flex: 1; background: transparent; color: var(--text); border: 1px solid var(--text); }
  .m-primary { flex: 2; background: var(--teal); color: var(--cream); border: none; letter-spacing: 0.18em; }
  .m-ghost:hover,
  .m-primary:hover { transform: translateY(-2px); }
  @media (max-width: 560px) {
    .modal-shell { padding: 36px 24px 24px; }
    .modal-title { font-size: 32px; }
    .modal-body :global(.modal-line) { font-size: 18px; }
  }
</style>
