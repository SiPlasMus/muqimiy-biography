---
const cols = [
  { h: 'Sahifalar', items: ['Hayoti', 'Ijodi', 'Asarlari'] },
  { h: 'Manbalar', items: ['tafakkur.net', 'n.ziyouz.com', 'arboblar.uz'] },
  { h: 'Tadqiqotlar', items: ['researchgate.net', 'cyberleninka.ru'] },
];
---
<footer class="site-footer">
  <div class="row">
    <div>
      <div class="title font-disp">Muqimiy</div>
      <div class="meta">1850 — 1903 · Qo'qon</div>
    </div>
    <div class="cols">
      {cols.map((col) => (
        <div>
          <div class="col-h">{col.h}</div>
          <div class="col-items">
            {col.items.map((t) => <div>{t}</div>)}
          </div>
        </div>
      ))}
    </div>
  </div>
  <div class="copyright">
    © 2026 Muqimiy sayti · Adabiy meros uchun hurmat va mehnat ila tuzilgan.
  </div>
</footer>

<style>
  .site-footer {
    background: var(--teal-deep);
    color: var(--cream);
    padding: 50px 60px 36px;
    margin-top: 80px;
  }
  .row {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    border-bottom: 1px solid rgba(244, 234, 212, 0.18);
    padding-bottom: 30px;
    margin-bottom: 20px;
    gap: 32px;
    flex-wrap: wrap;
  }
  .title {
    font-size: 36px;
    font-weight: 900;
  }
  .meta {
    font-size: 12px;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--saffron);
    margin-top: 4px;
  }
  .cols {
    display: flex;
    gap: 50px;
    flex-wrap: wrap;
  }
  .col-h {
    font-size: 10px;
    letter-spacing: 0.32em;
    color: var(--saffron);
    text-transform: uppercase;
    margin-bottom: 10px;
    font-weight: 700;
  }
  .col-items {
    font-size: 14px;
    line-height: 2;
  }
  .copyright {
    font-size: 12px;
    color: rgba(244, 234, 212, 0.5);
  }
  @media (max-width: 700px) {
    .site-footer { padding: 36px 24px 24px; }
    .cols { gap: 28px; }
  }
</style>
